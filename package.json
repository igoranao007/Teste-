{
  "name": "ps1-lab-animation",
  "version": "0.1.0",
  "private": true,
  "description": "Animação estilo PS1 (Three.js) editada no Remotion e exportada em MP4",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/video.mp4 --codec=h264",
    "still": "remotion still src/index.ts Main out/frame.png --frame=60",
    "mix": "bash scripts/mix-audio.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.544",
    "@remotion/cli": "^4.0.544",
    "@remotion/media-utils": "^4.0.544",
    "@remotion/three": "^4.0.544",
    "@remotion/transitions": "^4.0.544",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
