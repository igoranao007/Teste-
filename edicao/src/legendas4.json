 "legendas": [
  {
   "text": "Essa maleta precisa chegar ao destino. Não é uma entrega qualquer.",
   "quem": "adryan",
   "startMs": 10200,
   "endMs": 13759,
   "semVoz": false
  },
  {
   "text": "Tem coisa aí dentro que não pode simplesmente cair nas mãos de qualquer pessoa.",
   "quem": "adryan",
   "startMs": 13509,
   "endMs": 17069,
   "semVoz": false
  },
  {
   "text": "E você, Nicolas, não solta essa maleta por nada. Entendeu?",
   "quem": "adryan",
   "startMs": 18400,
   "endMs": 22883,
   "semVoz": false
  },
  {
   "text": "Boa noite. Completa pra mim.",
   "quem": "adryan",
   "startMs": 31600,
   "endMs": 37599,
   "semVoz": false
  },
  {
   "text": "Movimento fraco hoje, hein?",
   "quem": "adryan",
   "startMs": 40200,
   "endMs": 42604,
   "semVoz": false
  },
  {
   "text": "Beleza... também não precisa conversar.",
   "quem": "adryan",
   "startMs": 44600,
   "endMs": 46978,
   "semVoz": false
  },
  {
   "text": "Ô, Adryan! Meu parceiro! Tem uma moedinha aí?",
   "quem": "metalis",
   "startMs": 52800,
   "endMs": 57259,
   "semVoz": false
  },
  {
   "text": "Ah, não... Metalis. Você de novo?",
   "quem": "adryan",
   "startMs": 57400,
   "endMs": 60096,
   "semVoz": false
  },
  {
   "text": "Ué, vai me deixar na mão? Tô numa situação complicada, meu jovem.",
   "quem": "metalis",
   "startMs": 60200,
   "endMs": 64551,
   "semVoz": false
  },
  {
   "text": "Você sempre tá numa situação complicada.",
   "quem": "adryan",
   "startMs": 64700,
   "endMs": 70295,
   "semVoz": false
  },
  {
   "text": "É a vida, meu amigo. A vida não tá fácil pra ninguém.",
   "quem": "metalis",
   "startMs": 70400,
   "endMs": 73754,
   "semVoz": false
  },
  {
   "text": "Toma. Agora deixa a gente ir.",
   "quem": "adryan",
   "startMs": 74400,
   "endMs": 76701,
   "semVoz": false
  },
  {
   "text": "Sabia que podia contar contigo!",
   "quem": "metalis",
   "startMs": 77600,
   "endMs": 80107,
   "semVoz": false
  },
  {
   "text": "Vai cuidar da tua vida, Metalis.",
   "quem": "adryan",
   "startMs": 80000,
   "endMs": 82304,
   "semVoz": false
  },
  {
   "text": "Boa viagem!",
   "quem": "metalis",
   "startMs": 82600,
   "endMs": 83881,
   "semVoz": false
  },
  {
   "text": "Me entrega a maleta. Espera aqui fora e fica de olho em qualquer movimento.",
   "quem": "adryan",
   "startMs": 125600,
   "endMs": 131537,
   "semVoz": false
  },
  {
   "text": "Qual a senha?",
   "quem": "gusta",
   "startMs": 142900,
   "endMs": 144014,
   "semVoz": false
  },
  {
   "text": "15/03 007 BIFF.",
   "quem": "adryan",
   "startMs": 144300,
   "endMs": 147262,
   "semVoz": false
  },
  {
   "text": "Pode entrar.",
   "quem": "gusta",
   "startMs": 147000,
   "endMs": 149538,
   "semVoz": false
  },
  {
   "text": "Então... o Igor já sabe que a gente tá chegando?",
   "quem": "adryan",
   "startMs": 160500,
   "endMs": 163538,
   "semVoz": false
  },
  {
   "text": "Sabe.",
   "quem": "gusta",
   "startMs": 163700,
   "endMs": 164479,
   "semVoz": false
  },
  {
   "text": "Mas não é qualquer pessoa que pode ficar sabendo dessa missão.",
   "quem": "gusta",
   "startMs": 164500,
   "endMs": 169631,
   "semVoz": false
  },
  {
   "text": "Por quê?",
   "quem": "adryan",
   "startMs": 169800,
   "endMs": 170522,
   "semVoz": false
  },
  {
   "text": "Porque o Projeto Mogg é importante demais.",
   "quem": "gusta",
   "startMs": 170700,
   "endMs": 174057,
   "semVoz": false
  },
  {
   "text": "Isso não pode ser comentado em qualquer lugar. Nem mesmo fora daqui.",
   "quem": "gusta",
   "startMs": 173807,
   "endMs": 177164,
   "semVoz": false
  },
  {
   "text": "Você vai entender quando encontrar o Igor.",
   "quem": "gusta",
   "startMs": 177400,
   "endMs": 180160,
   "semVoz": false
  },
  {
   "text": "Nem mesmo no meu aniversário eles conseguem se segurar...",
   "quem": "igor",
   "startMs": 189100,
   "endMs": 192330,
   "semVoz": false
  },
  {
   "text": "Trouxeram?",
   "quem": "igor",
   "startMs": 197700,
   "endMs": 199584,
   "semVoz": false
  },
  {
   "text": "Todos eles têm potencial. Um potencial que não pode ser desperdiçado.",
   "quem": "igor",
   "startMs": 202300,
   "endMs": 206368,
   "semVoz": false
  },
  {
   "text": "Então... o Projeto Mogg.",
   "quem": "igor",
   "startMs": 206500,
   "endMs": 208318,
   "semVoz": false
  },
  {
   "text": "Então é isso. O Projeto Mogg.",
   "quem": "igor",
   "startMs": 214700,
   "endMs": 217390,
   "semVoz": false
  },
  {
   "text": "Vamos ver o que a Toca do Anão escondeu.",
   "quem": "igor",
   "startMs": 229500,
   "endMs": 231837,
   "semVoz": false
  },
  {
   "text": "O que eu disse, caralho? Que não era pra abrir a maleta!",
   "quem": "adryan",
   "startMs": 97000,
   "endMs": 100534,
   "semVoz": false
  },
  {
   "text": "Como assim? Não abri nada, pô.",
   "quem": "nicolas",
   "startMs": 100400,
   "endMs": 102650,
   "semVoz": true
  },
  {
   "text": "Não sei por que o Igor deu a confiança em você.",
   "quem": "adryan",
   "startMs": 103900,
   "endMs": 107133,
   "semVoz": false
  },
  {
   "text": "Como, caralho, isso aconteceu? Como?!",
   "quem": "igor",
   "startMs": 253000,
   "endMs": 256328,
   "semVoz": false
  },
  {
   "text": "Finalmente... depois de tanto tempo, nos encontramos.",
   "quem": "dom",
   "startMs": 257800,
   "endMs": 260732,
   "semVoz": false
  },
  {
   "text": "Dessa vez você não vai escapar, Igor.",
   "quem": "dom",
   "startMs": 260482,
   "endMs": 263415,
   "semVoz": false
  },
  {
   "text": "Dom?! É você?",
