 "legendas": [
  {
   "text": "Essa maleta precisa chegar ao destino. Não é uma entrega qualquer.",
   "quem": "adryan",
   "startMs": 10200,
   "endMs": 13759,
   "semVoz": false
  },
  {
   "text": "Tem coisa aí dentro que não pode simplesmente cair nas mãos de qualquer pessoa.",
   "quem": "adryan",
   "startMs": 13509,
   "endMs": 17069,
   "semVoz": false
  },
  {
   "text": "E você, Nicolas, não solta essa maleta por nada. Entendeu?",
   "quem": "adryan",
   "startMs": 18400,
   "endMs": 22883,
   "semVoz": false
  },
  {
   "text": "Boa noite. Completa pra mim.",
   "quem": "adryan",
   "startMs": 31600,
   "endMs": 37599,
   "semVoz": false
  },
  {
   "text": "Movimento fraco hoje, hein?",
   "quem": "adryan",
   "startMs": 40200,
   "endMs": 42604,
   "semVoz": false
  },
  {
   "text": "Beleza... também não precisa conversar.",
   "quem": "adryan",
   "startMs": 44600,
   "endMs": 46978,
   "semVoz": false
  },
  {
   "text": "Ô, Adryan! Meu parceiro! Tem uma moedinha aí?",
   "quem": "metalis",
   "startMs": 52800,
   "endMs": 57259,
   "semVoz": false
  },
  {
   "text": "Ah, não... Metalis. Você de novo?",
   "quem": "adryan",
   "startMs": 57400,
   "endMs": 60096,
   "semVoz": false
  },
  {
   "text": "Ué, vai me deixar na mão? Tô numa situação complicada, meu jovem.",
   "quem": "metalis",
   "startMs": 60200,
   "endMs": 64551,
   "semVoz": false
  },
  {
   "text": "Você sempre tá numa situação complicada.",
   "quem": "adryan",
   "startMs": 64700,
   "endMs": 70295,
   "semVoz": false
  },
  {
   "text": "É a vida, meu amigo. A vida não tá fácil pra ninguém.",
   "quem": "metalis",
   "startMs": 70400,
   "endMs": 73754,
   "semVoz": false
  },
  {
   "text": "Toma. Agora deixa a gente ir.",
   "quem": "adryan",
   "startMs": 74400,
   "endMs": 76701,
   "semVoz": false
  },
  {
   "text": "Sabia que podia contar contigo!",
   "quem": "metalis",
   "startMs": 77600,
   "endMs": 80107,
   "semVoz": false
  },
  {
   "text": "Vai cuidar da tua vida, Metalis.",
   "quem": "adryan",
   "startMs": 80000,
   "endMs": 82304,
   "semVoz": false
  },
  {
   "text": "Boa viagem!",
   "quem": "metalis",
   "startMs": 82600,
   "endMs": 83881,
   "semVoz": false
  },
  {
   "text": "Me entrega a maleta. Espera aqui fora e fica de olho em qualquer movimento.",
   "quem": "adryan",
   "startMs": 111600,
   "endMs": 117537,
   "semVoz": false
  },
  {
   "text": "Qual a senha?",
   "quem": "gusta",
   "startMs": 128900,
   "endMs": 130014,
   "semVoz": false
  },
  {
   "text": "15/03 007 BIFF.",
   "quem": "adryan",
   "startMs": 130300,
   "endMs": 133262,
   "semVoz": false
  },
  {
   "text": "Pode entrar.",
   "quem": "gusta",
   "startMs": 133000,
   "endMs": 135538,
   "semVoz": false
  },
  {
   "text": "Então... o Igor já sabe que a gente tá chegando?",
   "quem": "adryan",
   "startMs": 146500,
   "endMs": 149538,
   "semVoz": false
  },
  {
   "text": "Sabe.",
   "quem": "gusta",
   "startMs": 149700,
   "endMs": 150479,
   "semVoz": false
  },
  {
   "text": "Mas não é qualquer pessoa que pode ficar sabendo dessa missão.",
   "quem": "gusta",
   "startMs": 150500,
   "endMs": 155631,
   "semVoz": false
  },
  {
   "text": "Por quê?",
   "quem": "adryan",
   "startMs": 155800,
   "endMs": 156522,
   "semVoz": false
  },
  {
   "text": "Porque o Projeto Mogg é importante demais.",
   "quem": "gusta",
   "startMs": 156700,
   "endMs": 160057,
   "semVoz": false
  },
  {
   "text": "Isso não pode ser comentado em qualquer lugar. Nem mesmo fora daqui.",
   "quem": "gusta",
   "startMs": 159807,
   "endMs": 163164,
   "semVoz": false
  },
  {
   "text": "Você vai entender quando encontrar o Igor.",
   "quem": "gusta",
   "startMs": 163400,
   "endMs": 166160,
   "semVoz": false
  },
  {
   "text": "Nem mesmo no meu aniversário eles conseguem se segurar...",
   "quem": "igor",
   "startMs": 175100,
   "endMs": 178330,
   "semVoz": false
  },
  {
   "text": "Trouxeram?",
   "quem": "igor",
   "startMs": 183700,
   "endMs": 185584,
   "semVoz": false
  },
  {
   "text": "Todos eles têm potencial. Um potencial que não pode ser desperdiçado.",
   "quem": "igor",
   "startMs": 188300,
   "endMs": 192368,
   "semVoz": false
  },
  {
   "text": "Então... o Projeto Mogg.",
   "quem": "igor",
   "startMs": 192500,
   "endMs": 194318,
   "semVoz": false
  },
  {
