 "legendas": [
  {
   "text": "Essa maleta precisa chegar ao destino. Não é uma entrega qualquer.",
   "quem": "adryan",
   "startMs": 10200,
   "endMs": 13759,
   "semVoz": false
  },
  {
   "text": "Tem coisa aí dentro que não pode simplesmente cair nas mãos de qualquer pessoa.",
   "quem": "adryan",
   "startMs": 13509,
   "endMs": 17069,
   "semVoz": false
  },
  {
   "text": "E você, Nicolas, não solta essa maleta por nada. Entendeu?",
   "quem": "adryan",
   "startMs": 18400,
   "endMs": 22883,
   "semVoz": false
  },
  {
   "text": "Boa noite. Completa pra mim.",
   "quem": "adryan",
   "startMs": 31600,
   "endMs": 37599,
   "semVoz": false
  },
  {
   "text": "Movimento fraco hoje, hein?",
   "quem": "adryan",
   "startMs": 40200,
   "endMs": 42604,
   "semVoz": false
  },
  {
   "text": "Beleza... também não precisa conversar.",
   "quem": "adryan",
   "startMs": 44600,
   "endMs": 46978,
   "semVoz": false
  },
  {
   "text": "Ô, Adryan! Meu parceiro! Tem uma moedinha aí?",
   "quem": "metalis",
   "startMs": 50800,
   "endMs": 55259,
   "semVoz": false
  },
  {
   "text": "Ah, não... Metalis. Você de novo?",
   "quem": "adryan",
   "startMs": 55400,
   "endMs": 58096,
   "semVoz": false
  },
  {
   "text": "Ué, vai me deixar na mão? Tô numa situação complicada, meu jovem.",
   "quem": "metalis",
   "startMs": 58200,
   "endMs": 62551,
   "semVoz": false
  },
  {
   "text": "Você sempre tá numa situação complicada.",
   "quem": "adryan",
   "startMs": 62700,
   "endMs": 68295,
   "semVoz": false
  },
  {
   "text": "É a vida, meu amigo. A vida não tá fácil pra ninguém.",
   "quem": "metalis",
   "startMs": 68400,
   "endMs": 71754,
   "semVoz": false
  },
  {
   "text": "Toma. Agora deixa a gente ir.",
   "quem": "adryan",
   "startMs": 72400,
   "endMs": 74701,
   "semVoz": false
  },
  {
   "text": "Sabia que podia contar contigo!",
   "quem": "metalis",
   "startMs": 75600,
   "endMs": 78107,
   "semVoz": false
  },
  {
   "text": "Vai cuidar da tua vida, Metalis.",
   "quem": "adryan",
   "startMs": 78000,
   "endMs": 80304,
   "semVoz": false
  },
  {
   "text": "Boa viagem!",
   "quem": "metalis",
   "startMs": 80600,
   "endMs": 81881,
   "semVoz": false
  },
  {
   "text": "Me entrega a maleta. Espera aqui fora e fica de olho em qualquer movimento.",
   "quem": "adryan",
   "startMs": 109600,
   "endMs": 115537,
   "semVoz": false
  },
  {
   "text": "Qual a senha?",
   "quem": "gusta",
   "startMs": 119400,
   "endMs": 120514,
   "semVoz": false
  },
  {
   "text": "15/03 007 BIFF.",
   "quem": "adryan",
   "startMs": 120800,
   "endMs": 123762,
   "semVoz": false
  },
  {
   "text": "Pode entrar.",
   "quem": "gusta",
   "startMs": 123500,
   "endMs": 126038,
   "semVoz": false
  },
  {
   "text": "Então... o Igor já sabe que a gente tá chegando?",
   "quem": "adryan",
   "startMs": 137000,
   "endMs": 140038,
   "semVoz": false
  },
  {
   "text": "Sabe.",
   "quem": "gusta",
   "startMs": 140200,
   "endMs": 140979,
   "semVoz": false
  },
  {
   "text": "Mas não é qualquer pessoa que pode ficar sabendo dessa missão.",
   "quem": "gusta",
   "startMs": 141000,
   "endMs": 146131,
   "semVoz": false
  },
  {
   "text": "Por quê?",
   "quem": "adryan",
   "startMs": 146300,
   "endMs": 147022,
   "semVoz": false
  },
  {
   "text": "Porque o Projeto Mogg é importante demais.",
   "quem": "gusta",
   "startMs": 147200,
   "endMs": 150557,
   "semVoz": false
  },
  {
   "text": "Isso não pode ser comentado em qualquer lugar. Nem mesmo fora daqui.",
   "quem": "gusta",
   "startMs": 150307,
   "endMs": 153664,
   "semVoz": false
  },
  {
   "text": "Você vai entender quando encontrar o Igor.",
   "quem": "gusta",
   "startMs": 153900,
   "endMs": 156660,
   "semVoz": false
  },
  {
   "text": "Nem mesmo no meu aniversário eles conseguem se segurar...",
   "quem": "igor",
   "startMs": 165600,
   "endMs": 168830,
   "semVoz": false
  },
  {
   "text": "Trouxeram?",
   "quem": "igor",
   "startMs": 174200,
   "endMs": 176084,
   "semVoz": false
  },
  {
   "text": "Todos eles têm potencial. Um potencial que não pode ser desperdiçado.",
   "quem": "igor",
   "startMs": 178800,
   "endMs": 182868,
   "semVoz": false
  },
  {
   "text": "Então... o Projeto Mogg.",
   "quem": "igor",
   "startMs": 183000,
   "endMs": 184818,
   "semVoz": false
  },
  {
